rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Departments collection
    match /departments/{departmentId} {
      allow read, write: if true;
    }

    // 3. Patients collection
    match /patients/{patientId} {
      allow read, write: if true;
    }

    // 4. Appointments collection
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // 5. Admissions collection
    match /admissions/{admissionId} {
      allow read, write: if true;
    }

    // 6. Medical Records collection
    match /medical_records/{recordId} {
      allow read, write: if true;
    }

    // 7. Prescriptions collection
    match /prescriptions/{prescriptionId} {
      allow read, write: if true;
    }

    // 8. Vital Signs collection
    match /vital_signs/{vitalRecordId} {
      allow read, write: if true;
    }

    // 9. Nursing Notes collection
    match /nursing_notes/{noteId} {
      allow read, write: if true;
    }

    // 10. Bills collection
    match /bills/{billId} {
      allow read, write: if true;
    }

    // 11. Messages & Chat collection
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Default rule for all documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
